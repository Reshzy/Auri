# Public site URL used for auth redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk authentication — get keys from https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk route overrides (defaults match App Router pages below).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Local PostgreSQL (Drizzle runtime). Replace <LOCAL_POSTGRES_PASSWORD> in .env.local only.
DATABASE_URL=postgresql://postgres:<LOCAL_POSTGRES_PASSWORD>@localhost:5432/Auri

# Direct/session connection for drizzle-kit migrate/generate (local: same as DATABASE_URL).
# Production: Supabase direct or session-pooler URL (not the transaction pooler).
DIRECT_URL=postgresql://postgres:<LOCAL_POSTGRES_PASSWORD>@localhost:5432/Auri

# Private Storage bucket names (defaults match production Supabase overlays).
AURI_TEMPLATE_BUCKET=templates
AURI_GENERATED_BUCKET=generated-reports

# Trusted server/setup only — Supabase Storage for template upload and generated-report persistence.
# Never prefix the service role with NEXT_PUBLIC_. Never ship these to the browser.
# Service-role access bypasses RLS and is not proof of user authorization.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Default employee timezone.
AURI_DEFAULT_TIMEZONE=Asia/Manila

# Optional Playwright live Clerk Auth E2E (never invent credentials; use a real onboarded test user).
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000
